# Copy to .env. pg-boss connects directly to Postgres (docs/adr/0015 —
# replaces BullMQ/Redis) — same connection string as apps/api's
# DATABASE_URL (Supabase's Session pooler, port 5432).
DATABASE_URL=postgres://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
TRANSCRIPTION_WORKER_CONCURRENCY=2

API_BASE_URL=http://localhost:3001

# Provider abstraction (architecture.md §10, docs/adr/0002,
# docs/adr/0014, docs/adr/0017) — "groq" and "gemini" exist today for
# extraction. Get a free Groq key at console.groq.com/keys.
EXTRACTION_WORKER_CONCURRENCY=10
EXTRACTION_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini is the sole speech-understanding provider (docs/adr/0017) —
# transcription+diarization always run through it. Get a free key at
# aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
