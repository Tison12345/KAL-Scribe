# Copy to .env. REDIS_URL is required — same Redis apps/api uses.
# Hosted providers (Upstash, Redis Cloud, etc.) almost always need
# rediss:// (TLS), not redis:// — see apps/api/.env.example.
REDIS_URL=redis://localhost:6379
TRANSCRIPTION_WORKER_CONCURRENCY=2

API_BASE_URL=http://localhost:3001
ASR_SERVICE_URL=http://localhost:8787

# LLM provider abstraction (architecture.md §10, docs/adr/0002) — only
# "groq" exists today. Get a free API key at console.groq.com/keys.
EXTRACTION_WORKER_CONCURRENCY=10
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
