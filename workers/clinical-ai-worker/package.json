{
  "name": "@kal-scribe/clinical-ai-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Separately-deployed BullMQ worker process for the clinical-ai job pipeline (architecture.md §5, §13) — a stuck transcription job must never compete with apps/api's HTTP request latency.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@kal-scribe/config": "workspace:*",
    "@kal-scribe/llm-client": "workspace:*",
    "@kal-scribe/types": "workspace:*",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "ioredis": "5.10.1",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  }
}
