{
  "name": "@kal-scribe/clinical-ai-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Separately-deployed pg-boss worker process for the clinical-ai job pipeline (architecture.md §5, §13, docs/adr/0015) — a stuck transcription job must never compete with apps/api's HTTP request latency.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@kal-scribe/config": "workspace:*",
    "@kal-scribe/llm-client": "workspace:*",
    "@kal-scribe/types": "workspace:*",
    "dotenv": "^17.4.2",
    "pg-boss": "^12.26.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  }
}
