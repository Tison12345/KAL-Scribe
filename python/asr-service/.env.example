# Copy to .env. Every value has a working default.

# Only "whisperx" exists today (docs/adr/0001). Adding a new provider
# is one new file in app/stt/ + a new allowed value here.
STT_PROVIDER=whisperx

# small/cpu/int8 — deliberately CPU-friendly for now. See docs/adr/0009
# for the planned GPU upgrade path.
WHISPER_MODEL_SIZE=small
STT_DEVICE=cpu

PORT=8787

# Hugging Face token — required to activate real Pyannote diarization.
# Without it, every segment stays labeled "Speaker 1" (graceful
# degradation, not an error). Get one at huggingface.co/settings/tokens
# after accepting the gated-model terms on pyannote/speaker-diarization-3.1
# and pyannote/speaker-diarization-community-1.
HF_TOKEN=
