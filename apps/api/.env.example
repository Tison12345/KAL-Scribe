# Copy to .env and adjust as needed. Every value except NODE_ENV/PORT is
# required — real Supabase Postgres/Storage from day one, no local-dev
# stand-in (docs/adr/0014 supersedes docs/adr/0007/0008).

NODE_ENV=development
PORT=3001

# Real Postgres — Supabase's Session pooler connection string (not
# Transaction pooler, which doesn't support prepared statements).
DATABASE_URL=postgres://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Storage — the secret key (sb_secret_...), not the
# publishable key (signing upload/read URLs for arbitrary paths needs
# it). Create a private bucket in the same project and set its name
# below.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=consultation-audio

# Comma-separated allowed CORS origins for the real deployed frontend(s).
# Required for any real deployment — unset falls back to permissive
# localhost-only CORS, which is fine for local dev but not production.
WEB_APP_ORIGIN=https://kal-scribe-web.vercel.app

# Redis/BullMQ removed entirely (docs/adr/0015) — the job queue now
# runs on pg-boss, using DATABASE_URL above. No separate service, no
# separate quota to exhaust.

# Testing-mode toggle (docs/adr/0018) — set to "true" to also run
# workers/clinical-ai-worker's job-processing loop inside this same
# process, so a single-doctor manual test doesn't need anyone to run
# the worker separately. Leave unset/false for the normal, documented
# separate-worker architecture (docs/adr/0010) — that's what real
# production use should run. When true, this process also needs every
# var workers/clinical-ai-worker/.env.example lists (GEMINI_API_KEY at
# minimum) — apps/api doesn't need those for anything else.
EMBEDDED_WORKER=false
