# Copy to .env and adjust as needed. Every value has a working default
# for local dev except REDIS_URL, which is required — see below.

NODE_ENV=development
PORT=3001

# Leave unset for local dev/test: apps/api falls back to an embedded
# PGlite instance persisted under PGLITE_DATA_DIR, no Postgres or
# Docker required. Set this to point at a real Postgres (e.g.
# Supabase's) with no code changes — see docs/adr/0007.
# DATABASE_URL=postgres://user:password@host:5432/database
PGLITE_DATA_DIR=.data/pglite

# Only "local" exists today — the local-disk Storage stand-in
# (docs/adr/0007). Swapping to real Supabase Storage later adds a new
# adapter + a new allowed value here, not a rewrite.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage

# Signs/verifies the local storage stand-in's short-lived upload/read
# URLs. Has an insecure dev-only default if unset in development — set
# a real value before ever running with NODE_ENV=production.
# STORAGE_SIGNED_URL_SECRET=

# Required — BullMQ needs a real Redis-compatible server (no local
# stand-in exists for this one, unlike Postgres/Storage above).
# A genuinely local Redis (no TLS) uses redis://; a hosted provider
# (Upstash, Redis Cloud, etc.) almost always requires rediss:// (TLS)
# instead — using redis:// against a TLS-only endpoint fails with
# repeated ECONNRESET, not a clear auth/TLS error.
REDIS_URL=redis://localhost:6379

